# Generate these with: npm run generate-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Any long random string you make up yourself — used to protect the
# /api/cron/check endpoint from being triggered by strangers.
CRON_SECRET=

# These are added automatically when you connect Vercel KV to this
# project (Storage tab in your Vercel dashboard) — you don't need to
# fill them in by hand.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
